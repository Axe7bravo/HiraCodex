generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  TENANT
  LANDLORD
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum VerificationType {
  STUDENT
  LANDLORD
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PropertyStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  PAUSED
  INACTIVE
}

enum InquiryStatus {
  OPEN
  RESPONDED
  CLOSED
}

enum AccommodationRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  passwordHash          String
  role                  UserRole
  status                UserStatus             @default(ACTIVE)
  firstName             String
  lastName              String
  phone                 String?
  contactMethod         String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  tenantProfile         TenantProfile?
  landlordProfile       LandlordProfile?
  verifications         Verification[]         @relation("VerificationOwner")
  reviewedVerifications Verification[]         @relation("VerificationReviewer")
  properties            Property[]
  favourites            Favourite[]
  tenantInquiries       Inquiry[]              @relation("InquiryTenant")
  landlordInquiries     Inquiry[]              @relation("InquiryLandlord")
  tenantRequests        AccommodationRequest[] @relation("RequestTenant")
  landlordRequests      AccommodationRequest[] @relation("RequestLandlord")
  adminActions          AuditLog[]             @relation("AuditActor")

  @@index([role, status])
  @@index([createdAt])
}

model TenantProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  institution    String?
  expectedMoveIn DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LandlordProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  organisation  String?
  /// Landlord-declared portfolio count; never use as a cached count of Hira Property rows.
  propertyCount Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id              String             @id @default(cuid())
  userId          String
  type            VerificationType
  documentKey     String
  status          VerificationStatus @default(PENDING)
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  user            User               @relation("VerificationOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy      User?              @relation("VerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId, type, status])
  @@index([status, createdAt])
}

model Property {
  id                 String                 @id @default(cuid())
  landlordId         String
  title              String
  description        String
  monthlyPrice       Decimal                @db.Decimal(10, 2)
  roomType           String
  status             PropertyStatus         @default(DRAFT)
  availableFrom      DateTime
  amenities          String[]
  country            String                 @default("Lesotho")
  city               String                 @default("Maseru")
  area               String
  nearestInstitution String
  distanceNote       String?
  fullAddress        String?
  latitude           Decimal?               @db.Decimal(9, 6)
  longitude          Decimal?               @db.Decimal(9, 6)
  rejectionReason    String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  landlord           User                   @relation(fields: [landlordId], references: [id], onDelete: Restrict)
  photos             PropertyPhoto[]
  favourites         Favourite[]
  inquiries          Inquiry[]
  requests           AccommodationRequest[]

  @@index([status, createdAt])
  @@index([status, monthlyPrice])
  @@index([status, area])
  @@index([status, nearestInstitution])
  @@index([landlordId, status])
}

model PropertyPhoto {
  id         String   @id @default(cuid())
  propertyId String
  objectKey  String   @unique
  sortOrder  Int
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, sortOrder])
}

model Favourite {
  tenantId   String
  propertyId String
  createdAt  DateTime @default(now())
  tenant     User     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([tenantId, propertyId])
  @@index([propertyId])
}

model Inquiry {
  id         String        @id @default(cuid())
  propertyId String
  tenantId   String
  landlordId String
  moveInDate DateTime?
  message    String
  status     InquiryStatus @default(OPEN)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  property   Property      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  tenant     User          @relation("InquiryTenant", fields: [tenantId], references: [id], onDelete: Restrict)
  landlord   User          @relation("InquiryLandlord", fields: [landlordId], references: [id], onDelete: Restrict)

  @@index([tenantId, status, createdAt])
  @@index([landlordId, status, createdAt])
  @@index([propertyId])
}

model AccommodationRequest {
  id                  String                     @id @default(cuid())
  propertyId          String
  tenantId            String
  landlordId          String
  preferredMoveInDate DateTime
  note                String?
  status              AccommodationRequestStatus @default(PENDING)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  property            Property                   @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  tenant              User                       @relation("RequestTenant", fields: [tenantId], references: [id], onDelete: Restrict)
  landlord            User                       @relation("RequestLandlord", fields: [landlordId], references: [id], onDelete: Restrict)

  @@index([tenantId, status, createdAt])
  @@index([landlordId, status, createdAt])
  @@index([propertyId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
}
