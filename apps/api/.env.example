DATABASE_URL="postgresql://myuser:YOUR_PASSWORD@localhost:5432/hira?schema=public"
PORT=4000
WEB_ORIGIN="http://localhost:3000"
JWT_SECRET="replace-with-a-long-random-secret"
RESEND_API_KEY="re_replace-with-your-resend-api-key"
EMAIL_FROM="Hira <no-reply@example.com>"
VERIFICATION_STORAGE_DRIVER=local
# Optional override for the private local development store.
VERIFICATION_LOCAL_STORAGE_DIR=
# Required only when VERIFICATION_STORAGE_DRIVER=s3 (Cloudflare R2 or AWS S3).
VERIFICATION_S3_ENDPOINT=
VERIFICATION_S3_REGION=auto
VERIFICATION_S3_BUCKET=
VERIFICATION_S3_ACCESS_KEY_ID=
VERIFICATION_S3_SECRET_ACCESS_KEY=
PROPERTY_STORAGE_DRIVER=local
# Optional override for private local property photos.
PROPERTY_LOCAL_STORAGE_DIR=
# Required only when PROPERTY_STORAGE_DRIVER=s3 (Cloudflare R2 or AWS S3).
PROPERTY_S3_ENDPOINT=
PROPERTY_S3_REGION=auto
PROPERTY_S3_BUCKET=
PROPERTY_S3_ACCESS_KEY_ID=
PROPERTY_S3_SECRET_ACCESS_KEY=

# Optional analytics. Analytics is a no-op unless both values are configured.
POSTHOG_API_KEY=
POSTHOG_HOST=
