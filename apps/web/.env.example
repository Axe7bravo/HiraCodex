# Recommended for production and supported in development: browser requests
# stay on the web origin and Next.js forwards /api/* to API_PROXY_TARGET.
NEXT_PUBLIC_API_URL="/api"
# Required in production. This server-only HTTP(S) URL must be reachable from
# the Next.js server. It is never sent to the browser.
API_PROXY_TARGET="http://localhost:4000"
# Development only: exact HTTP(S) origin permitted to load this Next.js dev server.
# Example for a temporary tunnel: https://YOUR-TUNNEL.example
EXTERNAL_DEV_ORIGIN=

# Without this file, development retains the direct http://localhost:4000 API
# default. Production falls back to /api but still requires API_PROXY_TARGET.

# Optional browser analytics. The key must be a PostHog project ingestion key,
# never a personal or server administration key. Both values are required.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
